    {
      "name": "list_workout_events",
      "description": "Retrieve a paged list of workout events (updates or deletes) since a given date. Events are ordered from newest to oldest. The intention is to allow clients to keep their local cache of workouts up to date without having to fetch the entire list of workouts.",
      "method": "GET",
      "path": "/v1/workouts/events",
      "params": {
        "path": [],
        "query": [
          "page",
          "pageSize",
          "since"
        ]
      },
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "default": 1,
            "description": "Page number (Must be 1 or greater)"
          },
          "pageSize": {
            "type": "integer",
            "default": 10,
            "maximum": 10,
            "description": "Number of items on the requested page (Max 10)"
          },
          "since": {
            "type": "string",
            "default": "1970-01-01T00:00:00Z"
          }
        },
        "additionalProperties": false
      }
    },
