    {
      "name": "hevy",
      "description": "Read and log Hevy workouts, routines, exercises and body measurements with your personal Hevy API key.",
      "version": "1.0.0",
      "author": { "name": "Botkins", "url": "https://botkins.app" },
      "homepage": "https://developers.hevy.com",
      "repository": "https://github.com/promptclickrun/botkins-marketplace",
      "license": "MIT",
      "keywords": ["hevy", "fitness", "workouts", "gym", "health"],
      "category": "health",
      "auth": "api-key",
      "source": "./plugins/hevy"
    },
    {
      "name": "botkins-hill-climber",
      "description": "Bots that get better with use. Quiet hooks note corrections, stated preferences and repeated tool failures; retro and curate skills turn them into small, logged changes to memory, profiles, skills and the wiki.",
